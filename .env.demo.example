# Variables de la demo hosteada (Vercel + Neon). Copiar a .env.demo (no se sube a git) y completar.
# Las mismas variables van en Vercel → Project → Settings → Environment Variables.
# Pegá cada valor DIRECTAMENTE después del "=", sin espacios ni comillas.

# --- Base de datos (Neon) ---
# Conexión con pool (el host contiene "-pooler"):
DATABASE_URL=
# Conexión directa (sin "-pooler"), para migraciones:
DATABASE_URL_UNPOOLED=

# --- Sesión ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Usuarios demo (contraseña de todos los usuarios del seed) ---
SEED_USER_PASSWORD=

# --- LUCIA ---
LLM_PROVIDER=mock
