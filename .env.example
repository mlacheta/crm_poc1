# Copiar a .env y ajustar. Los valores por defecto coinciden con docker-compose.yml.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=lucia
POSTGRES_PASSWORD=lucia_dev
POSTGRES_DB=lucia
POSTGRES_PORT=5432
DATABASE_URL="postgresql://lucia:lucia_dev@localhost:5432/lucia?schema=public"

# --- Redis (docker compose) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Seed ---
# Contraseña de todos los usuarios creados por `npm run db:seed` (sólo desarrollo)
SEED_USER_PASSWORD=lucia1234

# --- Sesión (JWT firmado HS256, mínimo 32 caracteres) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=cambiar-por-un-secreto-aleatorio-de-32-caracteres-o-mas
